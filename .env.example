# GEMINI_API_KEY: Required for Gemini AI API calls.
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
# In local development: create a .env file and set your key.
# In Netlify: add GEMINI_API_KEY in Site configuration > Environment variables.
# In AI Studio: injected automatically or configured via Settings > Secrets.
GEMINI_API_KEY=your_api_key_here

